# ── ah5r-prod Conductor (where agent-handler workflows run) ──
# Create a Conductor application with read + workflow-execute access and put its
# key/secret here. The agent dispatches read-only commands against this server.
CONDUCTOR_SERVER_URL=https://ah5r-prod.orkesconductor.com/api
CONDUCTOR_AUTH_KEY=
CONDUCTOR_AUTH_SECRET=

# ── Slack (Socket Mode) ──
# Bot token from the Slack app (xoxb-...), and an app-level token with
# connections:write (xapp-...). Optionally restrict to one alert channel id.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ALERT_CHANNEL=

# ── Agentspan server (runs the agent loop + LLM calls) ──
AGENTSPAN_SERVER_URL=http://localhost:6767/api
# Claude model for the reasoning loop.
ONCALL_MODEL=anthropic/claude-sonnet-4-6
# Set ANTHROPIC_API_KEY on the Agentspan server process (not here) so it can call Claude.

# Advisory labelling only — the agent is read-only regardless. "false" drops the dry-run tag.
ONCALL_DRY_RUN=true
